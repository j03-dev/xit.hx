{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "xit",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "head_line"
          },
          {
            "type": "SYMBOL",
            "name": "repo_line"
          },
          {
            "type": "SYMBOL",
            "name": "keys_line"
          },
          {
            "type": "SYMBOL",
            "name": "help_line"
          },
          {
            "type": "SYMBOL",
            "name": "section_unmerged"
          },
          {
            "type": "SYMBOL",
            "name": "section_unstaged"
          },
          {
            "type": "SYMBOL",
            "name": "section_staged"
          },
          {
            "type": "SYMBOL",
            "name": "section_untracked"
          },
          {
            "type": "SYMBOL",
            "name": "section_recent_commits_header"
          },
          {
            "type": "SYMBOL",
            "name": "section_commit_graph_header"
          },
          {
            "type": "SYMBOL",
            "name": "section_branches_header"
          },
          {
            "type": "SYMBOL",
            "name": "section_graph_header"
          },
          {
            "type": "SYMBOL",
            "name": "commit"
          },
          {
            "type": "SYMBOL",
            "name": "graph_rail_line"
          },
          {
            "type": "SYMBOL",
            "name": "branch_line"
          },
          {
            "type": "SYMBOL",
            "name": "diff_line"
          },
          {
            "type": "SYMBOL",
            "name": "message_line"
          }
        ]
      }
    },
    "head_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "Head:[^\\n\\r]*"
        }
      }
    },
    "repo_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "Repo:[^\\n\\r]*"
        }
      }
    },
    "keys_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "Keys:[^\\n\\r]*"
        }
      }
    },
    "help_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "  (o[ \\t]{6,}|(:git-save)[ \\t]{1,}|(s|u|v\\/V\\/C-j|d|ret\\/tab|D|O|T|c|C|S|U|P|p|b|r|q)[ \\t]{2,})[^\\n\\r]*"
        }
      }
    },
    "section_unmerged": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "section_unmerged_header"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "entry"
          }
        }
      ]
    },
    "section_unstaged": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "section_unstaged_header"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "entry"
          }
        }
      ]
    },
    "section_staged": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "section_staged_header"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "entry"
          }
        }
      ]
    },
    "section_untracked": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "section_untracked_header"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "entry"
          }
        }
      ]
    },
    "section_unmerged_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "Unmerged \\([0-9]+\\)"
      }
    },
    "section_unstaged_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "Unstaged \\([0-9]+\\)"
      }
    },
    "section_staged_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "Staged \\([0-9]+\\)"
      }
    },
    "section_untracked_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "Untracked \\([0-9]+\\)"
      }
    },
    "section_recent_commits_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "Recent Commits \\([0-9]+\\)"
      }
    },
    "section_commit_graph_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "Commit Graph \\([0-9]+\\)"
      }
    },
    "section_branches_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "Branches \\([0-9]+\\)"
      }
    },
    "section_graph_header": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "Branch Graph"
      }
    },
    "entry": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "> "
            },
            {
              "type": "PATTERN",
              "value": "v "
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "status",
          "content": {
            "type": "SYMBOL",
            "name": "git_status"
          }
        },
        {
          "type": "PATTERN",
          "value": "[ ]{2}"
        },
        {
          "type": "FIELD",
          "name": "path",
          "content": {
            "type": "SYMBOL",
            "name": "path"
          }
        }
      ]
    },
    "git_status": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "status_unmerged"
        },
        {
          "type": "SYMBOL",
          "name": "status_added"
        },
        {
          "type": "SYMBOL",
          "name": "status_copied"
        },
        {
          "type": "SYMBOL",
          "name": "status_deleted"
        },
        {
          "type": "SYMBOL",
          "name": "status_modified"
        },
        {
          "type": "SYMBOL",
          "name": "status_renamed"
        },
        {
          "type": "SYMBOL",
          "name": "status_untracked"
        }
      ]
    },
    "status_unmerged": {
      "type": "PATTERN",
      "value": "(UU|UA|AU|UD|DU|AA|DD|U)"
    },
    "status_added": {
      "type": "PATTERN",
      "value": "A"
    },
    "status_copied": {
      "type": "PATTERN",
      "value": "C"
    },
    "status_deleted": {
      "type": "PATTERN",
      "value": "D"
    },
    "status_modified": {
      "type": "PATTERN",
      "value": "M"
    },
    "status_renamed": {
      "type": "PATTERN",
      "value": "R"
    },
    "status_untracked": {
      "type": "PATTERN",
      "value": "\\?"
    },
    "path": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n\\r]+"
      }
    },
    "diff_line": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "diff_add"
        },
        {
          "type": "SYMBOL",
          "name": "diff_del"
        },
        {
          "type": "SYMBOL",
          "name": "diff_context"
        }
      ]
    },
    "diff_add": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "[ ]{4}\\+[^\\n\\r]*"
        }
      }
    },
    "diff_del": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "[ ]{4}-[^\\n\\r]*"
        }
      }
    },
    "diff_context": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "[ ]{4}[^\\n\\r]*"
        }
      }
    },
    "commit": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "graph",
          "content": {
            "type": "SYMBOL",
            "name": "graph_prefix"
          }
        },
        {
          "type": "FIELD",
          "name": "hash",
          "content": {
            "type": "SYMBOL",
            "name": "commit_hash"
          }
        },
        {
          "type": "PATTERN",
          "value": "[ ]"
        },
        {
          "type": "FIELD",
          "name": "author",
          "content": {
            "type": "SYMBOL",
            "name": "commit_author"
          }
        },
        {
          "type": "PATTERN",
          "value": "[ ]"
        },
        {
          "type": "FIELD",
          "name": "subject",
          "content": {
            "type": "SYMBOL",
            "name": "commit_subject"
          }
        }
      ]
    },
    "graph_rail_line": {
      "type": "FIELD",
      "name": "graph",
      "content": {
        "type": "SYMBOL",
        "name": "graph_prefix"
      }
    },
    "graph_prefix": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[*o|\\\\\\/ ]+"
      }
    },
    "commit_hash": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[0-9a-f]{7,40}"
      }
    },
    "commit_author": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\u200B\\n\\r]+\\u200B"
      }
    },
    "commit_subject": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "[^\\n\\r]+"
      }
    },
    "branch_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 3,
        "content": {
          "type": "PATTERN",
          "value": "(\\*|  )[^\\n\\r]* ↑[0-9]+ ↓[0-9]+ [^\\n\\r]*"
        }
      }
    },
    "message_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[^ \\n\\r][^\\n\\r]*"
        }
      }
    }
  },
  "extras": [
    {
      "type": "STRING",
      "value": "\n"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}